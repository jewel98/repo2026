//Different processors may arrange multibyte values differently. Network protocols use a standard ordering called network byte order.

#include <arpa/inet.h>
#include <stdint.h>
#include <stdio.h>

int main(void) {
    uint16_t host_port = 8080;

    uint16_t network_port = htons(host_port);
    uint16_t restored_port = ntohs(network_port);

    printf("Port: %u\n", restored_port);
    return 0;
}


| Function  | Meaning                       |
| --------- | ----------------------------- |
| `htons()` | Host to network, 16-bit short |
| `ntohs()` | Network to host, 16-bit short |
| `htonl()` | Host to network, 32-bit long  |
| `ntohl()` | Network to host, 32-bit long  |

Port numbers are normally converted using htons():
address.sin_port = htons(8080);

