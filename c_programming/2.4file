FILE *fptr;
fptr = fopen(filename, mode);

w - Writes to a file
a - Appends new data to a file
r - Reads from a file


FILE *fptr;

// Create a file
fptr = fopen("filename.txt", "w");

// Close the file
fclose(fptr);


fptr = fopen("C:\directory\filename.txt", "w");


////Writing in a File
FILE *fptr;

// Open a file in writing mode
fptr = fopen("filename.txt", "w");

// Write some text to the file
fprintf(fptr, “The first line");

// Close the file
fclose(fptr);




////Append Content To a File

FILE *fptr;

// Open a file in append mode
fptr = fopen("filename.txt", "a");

// Append some text to the file
fprintf(fptr, "\nThis is the second line!");

// Close the file
fclose(fptr);




////C Read Files
FILE *fptr;

// Open a file in read mode
fptr = fopen("filename.txt", "r");

// Store the content of the file
char myString[100];

// Read the content and store it inside myString
fgets(myString, 100, fptr);

// Print the file content
printf("%s", myString);

// Close the file
fclose(fptr);



Example: Read two lines from a file
Create an input.txt file:
This is the first line.
This is the second line.

#include <stdio.h>
#include <stdlib.h>

int main(void) {
    FILE *file;
    char line[256];

    file = fopen("input.txt", "r");

    if (file == NULL) {
        perror("Cannot open input.txt");
        return EXIT_FAILURE;
    }

    for (int i = 1; i <= 2; i++) {
        if (fgets(line, sizeof(line), file) != NULL) {
            printf("Line %d: %s", i, line);
        }
        else {
            printf("The file contains fewer than two lines.\n");
            break;
        }
    }

    fclose(file);
    return EXIT_SUCCESS;
}

Example: Write two lines into a file
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    FILE *file;

    file = fopen("output.txt", "w");

    if (file == NULL) {
        perror("Cannot open output.txt");
        return EXIT_FAILURE;
    }

    fputs("This is the first line.\n", file);
    fputs("This is the second line.\n", file);

    fclose(file);

    printf("Two lines were written to output.txt.\n");

    return EXIT_SUCCESS;
}

Important file modes:

"r": Open for reading.
"w": Open for writing and erase existing content.
"a": Open for writing and append to existing content.


gcc -Wall -Wextra write_file.c -o write_file //with warning
./write_file

=============

fets: Reading Line-by-Line

======

#include <stdio.h>

int main() {
    // 1. Open the file in read ("r") mode
    FILE *filePointer = fopen("example.txt", "r");

    // Always check if the file exists / opened successfully
    if (filePointer == NULL) {
        printf("Error: Could not open file.\n");
        return 1;
    }

    // Create a buffer array to store each line
    char buffer[256];

    // 2. Loop through the file until fgets returns NULL (End of File)
    while (fgets(buffer, sizeof(buffer), filePointer) != NULL) {
        printf("%s", buffer);
    }

    // 3. Always close the file stream when done
    fclose(filePointer);
    return 0;
}

============

fgetc: Reading Character-by-Character

====

#include <stdio.h>

int main() {
    FILE *filePointer = fopen("example.txt", "r");

    if (filePointer == NULL) {
        printf("Error: Could not open file.\n");
        return 1;
    }

    int ch; // Must be an int to correctly capture the 'EOF' token

    // Read and print one character at a time until End of File (EOF)
    while ((ch = fgetc(filePointer)) != EOF) {
        putchar(ch);
    }

    fclose(filePointer);
    return 0;
}


=====

fscanf: Reading Formatted/Structured Data

======

#include <stdio.h>

int main() {
    FILE *filePointer = fopen("data.txt", "r");

    if (filePointer == NULL) {
        printf("Error opening file.\n");
        return 1;
    }

    char name[50];
    int age;

    // Assumes file format looks like: John 25
    while (fscanf(filePointer, "%49s %d", name, &age) == 2) {
        printf("Name: %s, Age: %d\n", name, age);
    }

    fclose(filePointer);
    return 0;
}
