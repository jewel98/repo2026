//An array is a collection of elements of the same data type stored in contiguous memory locations.


#include <stdio.h>

int main() {
    int scores[5] = {80, 85, 90, 75, 95};

    printf("%d\n", scores[0]);
    printf("%d\n", scores[2]);

    scores[1] = 88;

    printf("%d\n", scores[1]);

    return 0;
}



#include <stdio.h>

int main() {
    int scores[5] = {80, 85, 90, 75, 95};
    int i;

    for (i = 0; i < 5; i++) {
        printf("%d\n", scores[i]);
    }

    return 0;
}


Important: Accessing an array outside its valid index range, such as scores[5] in this example, causes undefined behavior.


Problem: Write a C program that stores five student scores, calculates their average, and counts how many students passed (score of 60 or higher).


#include <stdio.h>

int main() {
    int scores[5] = {85, 45, 90, 72, 55};
    int i, passed = 0;
    int total = 0;
    float average;

    for (i = 0; i < 5; i++) {
        total = total + scores[i];

        if (scores[i] >= 60) {
            passed++;
        }
    }

    average = total / 5.0;

    printf("Total Score: %d\n", total);
    printf("Average Score: %.2f\n", average);
    printf("Students Passed: %d\n", passed);

    return 0;
}
