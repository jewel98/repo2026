import socket

# Bind to 0.0.0.0 to listen on all network interfaces
HOST = '0.0.0.0'
PORT = 8080  # Ensure this port is open in your GCP firewall

# Create a standard TCP Socket
server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1) # Allows immediate port reuse
server.bind((HOST, PORT))
server.listen(5)

print(f"Python Server is up and listening on port {PORT}...")

try:
    while True:
        # Wait and accept incoming client connections
        client_socket, client_address = server.accept()
        print(f"Connected to client from: {client_address}")
        
        # Receive data from the client (up to 1024 bytes)
        data = client_socket.recv(1024)
        if data:
            print(f"Received message: {data.decode('utf-8')}")
            
            # Send a confirmation response back to the client
            client_socket.sendall(b"Hello from the GCP Python Server!")
            
        client_socket.close()
except KeyboardInterrupt:
    print("\nShutting down server.")
finally:
    server.close()


